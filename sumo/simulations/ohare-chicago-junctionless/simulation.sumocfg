<configuration>
    <input>
        <net-file value="network.net.xml"/>
        <route-files value="optimized_routes.rou.xml"/>
        <additional-files value="grid_taz.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="0.5"/>
    </time>

    <report>
        <tripinfo-output value="./output/tripinfo.xml"/>
        <fcd-output value="./output/fcd.xml"/>
        <fcd-output.geo value="true"/>
    </report>

    <gui_only>
        <gui-settings-file value="view.xml"/>
    </gui_only>
</configuration>