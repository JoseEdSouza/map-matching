        <di:waypoint x="1080" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_GatewayCheck_di" bpmnElement="Flow_To_GatewayCheck">
        <di:waypoint x="1180" y="530" />
