<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Pipeline de Geração de Dataset (TCC)" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_4" name="Validação e Benchmark">
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Pós-processamento e GNSS">
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Simulação (SUMO/TraCI)">
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Aquisição e Preparação (OSM/SUMO)">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Início do processo">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_1" name="Extrair rede viária (OSMnx)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1">
        <bpmn:targetRef>DataObject_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_2" name="Filtrar entidades (osmfilter)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_2">
        <bpmn:targetRef>DataObject_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_3" name="Converter rede (netconvert)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_3">
        <bpmn:targetRef>DataObject_3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataObjectReference id="DataObject_1" name="Rede Bruta (XML/GraphML)" dataObjectRef="DO_1" />
    <bpmn:dataObject id="DO_1" />
    <bpmn:dataObjectReference id="DataObject_2" name="Rede OSM Filtrada" dataObjectRef="DO_2" />
    <bpmn:dataObject id="DO_2" />
    <bpmn:dataObjectReference id="DataObject_3" name="Rede SUMO" dataObjectRef="DO_3" />
    <bpmn:dataObject id="DO_3" />
    <bpmn:serviceTask id="Task_4" name="Gerar viagens (randomTrips.py)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_Loop_2</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_4">
        <bpmn:targetRef>DataObject_4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_5" name="Executar simulação (SUMO)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_6" name="Coletar dados (TraCI)">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_5">
        <bpmn:targetRef>DataObject_5</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataObjectReference id="DataObject_4" name="Rotas/Viagens" dataObjectRef="DO_4" />
    <bpmn:dataObject id="DO_4" />
    <bpmn:dataObjectReference id="DataObject_5" name="Ground Truth Bruto" dataObjectRef="DO_5" />
    <bpmn:dataObject id="DO_5" />
    <bpmn:serviceTask id="Task_7" name="Reconstruir mapeamento SUMO-OSM">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_Loop_1</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_6">
        <bpmn:targetRef>DataObject_6</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_8" name="Gerar medições GNSS (Ruído Gaussiano)">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_7">
        <bpmn:targetRef>DataObject_7</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_9" name="Persistir dados (Parquet)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_8">
        <bpmn:targetRef>DataObject_8</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_11" name="Corrigir inconsistências">
      <bpmn:incoming>Flow_No_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Loop_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_13" name="Ajustar parâmetros">
      <bpmn:incoming>Flow_No_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Loop_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataObjectReference id="DataObject_6" name="Ground Truth Mapeado" dataObjectRef="DO_6" />
    <bpmn:dataObject id="DO_6" />
    <bpmn:dataObjectReference id="DataObject_7" name="Medições GNSS (Ruidoso)" dataObjectRef="DO_7" />
    <bpmn:dataObject id="DO_7" />
    <bpmn:dataObjectReference id="DataObject_8" name="Dataset Parquet" dataObjectRef="DO_8" />
    <bpmn:dataObject id="DO_8" />
    <bpmn:userTask id="Task_10" name="Validação preliminar (Manual)">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1" name="Integridade OK?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_No_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_2" name="Diferenças OK?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_No_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_1" name="Dataset Finalizado">
      <bpmn:incoming>Flow_Yes_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_12" name="Validação final em múltiplas ferramentas">
      <bpmn:incoming>Flow_Yes_1</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
